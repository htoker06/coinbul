# Bu dosyayı .env adıyla kopyalayın ve düzenleyin. .env dosyasını kimseyle paylaşmayın.

# paper = sanal para (varsayılan), live = GERÇEK PARA
MODE=paper
# Canlı mod için ayrıca bunu EVET yapmanız gerekir
CONFIRM_LIVE=

# Binance TR > Hesabım > API Yönetimi. Sadece "Okuma" ve "Spot İşlem" izni verin,
# "Para Çekme" iznini KAPALI tutun, IP kısıtlaması ekleyin.
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=

PAPER_START_TRY=10000
TRADE_SIZE_TRY=500
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_TRY=750
STOP_LOSS_PCT=3
TAKE_PROFIT_PCT=6
TRAILING_START_PCT=3
TRAILING_PCT=1.5
MAX_HOLD_HOURS=48

BUY_SCORE=0.45
MAX_FAKE_SCORE=0.4
MAX_SPREAD_PCT=0.4
MAX_24H_CHANGE_PCT=25
MIN_QUOTE_VOLUME_TRY=2000000
MAX_SYMBOLS=60
LOOP_SECONDS=60
