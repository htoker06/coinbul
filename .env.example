# Bu dosyayı .env adıyla kopyalayın ve düzenleyin. .env dosyasını kimseyle paylaşmayın.

# ---------------------------------------------------------------- Mod
# paper = sanal para (varsayılan), live = GERÇEK PARA
MODE=paper
# Canlı mod için ayrıca bunu EVET yapmanız gerekir
CONFIRM_LIVE=
PAPER_START_TRY=10000
# İşlem başına komisyon oranı (0.001 = %0,1). Binance TR'deki kendi oranınızı yazın;
# hem sanal mod hem geçmiş veri testi bu oranla hesaplar.
FEE_RATE=0.001

# Binance TR > Hesabım > API Yönetimi. Sadece "Okuma" ve "Spot İşlem" izni verin,
# "Para Çekme" iznini KAPALI tutun, IP kısıtlaması ekleyin.
BINANCE_TR_API_KEY=
BINANCE_TR_API_SECRET=

# ---------------------------------------------------------------- Tutar ve risk (2, 4)
# Stop olursa bir işlemde kaybedilecek yaklaşık tutar. Alım tutarı buna ve coinin oynaklığına göre hesaplanır.
RISK_PER_TRADE_TRY=30
MIN_TRADE_TRY=200
MAX_TRADE_TRY=1000
MAX_OPEN_POSITIONS=3
MAX_DAILY_LOSS_TRY=750
MAX_WEEKLY_LOSS_TRY=2000
# Stop mesafesi = ATR x ATR_MULT, en az MIN_STOP_PCT, en fazla MAX_STOP_PCT
ATR_MULT=2
MIN_STOP_PCT=1.5
MAX_STOP_PCT=8
# Kâr al = stop mesafesi x REWARD_RISK
REWARD_RISK=2
TRAILING_START_R=1
TRAILING_ATR_MULT=1.5
MAX_HOLD_HOURS=48

# ---------------------------------------------------------------- Kademeli satış (16)
PARTIAL_TAKE_R=1
PARTIAL_FRACTION=0.5

# ---------------------------------------------------------------- Molalar (3)
MAX_CONSECUTIVE_LOSSES=3
LOSS_PAUSE_MINUTES=120
SYMBOL_COOLDOWN_HOURS=6
# Kârla da satılsa aynı coini bu kadar saat yeniden alma, günde en fazla bu kadar alım
REENTRY_COOLDOWN_HOURS=6
MAX_DAILY_BUYS=4

# ---------------------------------------------------------------- "Sinyal döndü" satışı
# Sadece pozisyon zarardayken ve satış sinyali bu kadar tur sürdüyse satar
SIGNAL_EXIT_ROUNDS=2
SIGNAL_EXIT_ONLY_LOSS=true

# ---------------------------------------------------------------- Komisyon kontrolü
# Kâr hedefi, (2 x komisyon + tahmini kayma) maliyetinin en az bu katı olmalı
MIN_EDGE_MULT=5
EST_SLIPPAGE_PCT=0.1

# ---------------------------------------------------------------- Alım kuralları
BUY_SCORE=0.6
MAX_FAKE_SCORE=0.4
MAX_SPREAD_PCT=0.4
MAX_24H_CHANGE_PCT=25
# (11) sinyal kaç tur (dakika) üst üste sürmeli
CONFIRM_ROUNDS=2
# (7) virgülle ayrılmış, alınmayacak coinler
BLACKLIST=
MIN_LISTING_DAYS=14
# (17) Türkiye saatiyle alım yapılmayan saatler (boş bırakırsanız kapalı)
NO_BUY_HOURS=2-8

# (1) Bitcoin filtresi
BTC_FILTER=true
BTC_MAX_DROP_1H_PCT=2

# (8) Pump koruması
PUMP_5M_PCT=5
PUMP_PULLBACK_PCT=1.5
PUMP_WATCH_MINUTES=120

# (9) Global Binance karşılaştırması
GLOBAL_CHECK=true
MAX_PREMIUM_PCT=1.5
LOCAL_RVOL_RATIO=2.5

# (5) Emir tipi ve kayma sınırı
ORDER_TYPE=limit
MAX_SLIPPAGE_PCT=0.3

# (6) Canlı modda stop emrini borsaya da yaz
EXCHANGE_STOP=true

# ---------------------------------------------------------------- Tarama
MIN_QUOTE_VOLUME_TRY=2000000
MAX_SYMBOLS=60
LOOP_SECONDS=60

# ---------------------------------------------------------------- Telegram (14)
# Telegram'da @BotFather'a /newbot yazın, verdiği anahtarı TELEGRAM_TOKEN'a yazın.
# Sonra botunuza bir mesaj atın ve https://api.telegram.org/bot<TOKEN>/getUpdates adresinde
# görünen "chat":{"id": ...} sayısını TELEGRAM_CHAT_ID'ye yazın.
TELEGRAM_TOKEN=
TELEGRAM_CHAT_ID=
DAILY_REPORT_HOUR=23
